# pacod full-stack demo: the central configuration.
#
# This is the only file to edit. `make up` reads it, generates every secret once into
# .state/secrets.env, renders each product's own variables into .state/env/<product>.env and
# starts the stack. Values here override nothing in the five repositories; they are passed to
# their compose files by the demo.
#
# After a change: `make up` again (it recreates what changed). Changing DEMO_DOMAIN or
# DEMO_HTTP_PORT also rebuilds the app's frontend (its sign-in issuer is a build argument) and
# changes every URL the bootstrap registered; run `make clean` first if you change them on a
# stack that already has data.

# ---- Where the stack answers ---------------------------------------------------------------

# Every UI and API is a host name under this domain, on one port of one Caddy (pacod-caddy):
# http://app.<domain>:<port>, http://id.<domain>:<port>, ... `localhost` needs no DNS: browsers
# (Chrome, Firefox, Edge) and curl resolve *.localhost to 127.0.0.1. Safari may not; use
# `make hosts` to print /etc/hosts lines for it.
DEMO_DOMAIN=ctest.local
DEMO_HTTP_PORT=8800
# The address the port is published on. 127.0.0.1 keeps the demo on this machine; 0.0.0.0
# would expose it to the network (then also set DEMO_DOMAIN to a name the other machines resolve).
DEMO_BIND=0.0.0.0

# ---- The first administrator ---------------------------------------------------------------

# One account for everything (single sign-on): pacod-id admin, app superuser and admin, gateway
# platform admin, CMS platform admin and knowledge-base admin. The password needs 12 characters
# or more; leave it empty and `make up` generates one (shown by `make urls`).
DEMO_ADMIN_EMAIL=admin@pacod.demo
DEMO_ADMIN_PASSWORD=

# ---- Optional component --------------------------------------------------------------------

# `ingestion`: the app's document ingestion service (a ~10 GB image) and the starter agent's
# knowledge base. Empty: off.
DEMO_PROFILES=

# ---- LLM providers -------------------------------------------------------------------------

# Empty keys: every model call goes to the gateway's mock provider (gw-mock); the demo runs
# offline and `make verify` is deterministic. With at least one key set, `make up` (or
# `make bootstrap`) configures the gateway with the real providers instead; providers without
# a key stay configured but fail their calls. The app's default models are Anthropic's.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# The models the products ask the gateway for (names from the gateway's model list,
# pacod-ap/deploy/pacod-gw/platform-config.*.json).
AP_PRIMARY_MODEL=anthropic/claude-sonnet-5-5
AP_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5
CMS_AI_MODEL=anthropic/claude-haiku-4-5
KB_LLM_MODEL=anthropic/claude-haiku-4-5

# ---- Resources -----------------------------------------------------------------------------

# The shared embeddings service (pacod-embeddings, used by the app and the knowledge base):
# `bge` runs BAAI/bge-m3 and its reranker (a 4 GB download on the first start; the whole stack
# then uses about 5 GiB); `hash` is a tiny stand-in with no model (search still works, its
# quality drops); `auto` picks bge when Docker has about 8 GB of memory or more, else hash. The choice is fixed at
# the first `make up` (the stored vectors depend on it); changing it later needs `make clean`.
EMBEDDINGS_BACKEND=auto
# CPU threads for model inference.
TORCH_NUM_THREADS=4
