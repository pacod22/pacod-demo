.state/
__pycache__/

# The machine's configuration, copied from demo.env.example (the committed template) by make.
demo.env
# The machine's own values for demo.env: the admin's password, provider keys.
demo.local.env
# The HTTPS certificate and key (certs/README.md): never committed.
certs/demo.pacod.io.crt
certs/demo.pacod.io.key
# Any other certificate or key put there too; only the README is tracked.
certs/*
!certs/README.md
