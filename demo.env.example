# pacod full-stack demo: the central configuration.
#
# demo.env is this machine's copy of demo.env.example (the committed template; `make` copies it
# the first time) and git ignores it: edit demo.env, and demo.env.example only for a change every
# machine should get. Keep secrets out of both: the admin's password and the provider keys go in
# demo.local.env (never committed, read after this file: what it sets wins). `make up`
# reads both, generates every secret once into
# .state/secrets.env, renders each product's own variables into .state/env/<product>.env and
# starts the stack. Values here override nothing in the six repositories; they are passed to
# their compose files by the demo.
#
# After a change: `make up` again (it recreates what changed). Changing DEMO_DOMAIN, the ports
# or HTTPS on or off also rebuilds the app's frontend (its sign-in issuer is a build argument)
# and changes every URL the bootstrap registered, as DEMO_SITE_DOMAIN changes the demo websites'
# addresses; run `make clean` first if you change them on a stack that already has data.

# ---- Where the stack answers ---------------------------------------------------------------

# Every UI and API is a host name under this domain, on one Caddy (pacod-caddy):
# https://app.<domain>, https://id.<domain>, ... and the home page at https://<domain>.
# The DNS needs <domain> and *.<domain> pointing at this machine (`make hosts` prints
# /etc/hosts lines to try it before the DNS is set).
# For a demo on this machine only: DEMO_DOMAIN=localhost (browsers and curl resolve
# *.localhost to 127.0.0.1 without DNS; Safari may not), DEMO_TLS_CERT and DEMO_TLS_KEY empty,
# DEMO_HTTP_PORT=8800 and DEMO_BIND=127.0.0.1: http://app.localhost:8800, ...
DEMO_DOMAIN=demo.pacod.io

# The CMS's websites answer under this domain: the demo's at <DEMO_CMS_SUBDOMAIN>.<site domain>,
# <DEMO_CMS_MINIMAL_SUBDOMAIN>.<site domain> and <DEMO_CMS_SPACE_SUBDOMAIN>.<site domain>, every
# website made in the studio at <id>.<site domain>. A website runs its owner's script, so by default this must be another
# registrable domain than DEMO_DOMAIN's (not demo.pacod.io, nor sites.pacod.io next to it, but e.g.
# pacod-sites.net): on the same one the script could set cookies the studio and the sign-in
# receive, and the studio refuses to start. (The other way: a domain registered in the Public
# Suffix List's private section, which takes weeks.) The DNS needs *.<site domain> pointing at this
# machine too. Empty: DEMO_DOMAIN, which only `localhost` passes (a public suffix: every website has
# a registrable domain of its own) -- or any domain with DEMO_SITE_DOMAIN_SHARED=true.
DEMO_SITE_DOMAIN=

# true: the CMS's websites may share DEMO_DOMAIN's registrable domain, e.g. the demo website at
# cms.demo.pacod.io beside studio.demo.pacod.io (DEMO_SITE_DOMAIN empty or demo.pacod.io). The
# price: a website's script can then set cookies for every product on that domain -- the studio,
# the sign-in, the app, the gateway console, the knowledge base, Grafana -- so only for a demo
# whose websites are all trusted. Needs HTTPS (DEMO_TLS_CERT), where the studio's and the sign-in's
# own cookies are __Host- cookies no other host can set. The studio starts with a warning then.
DEMO_SITE_DOMAIN_SHARED=false

# The CMS's subdomains: the studio at <DEMO_STUDIO_SUBDOMAIN>.<DEMO_DOMAIN>, the demo websites
# "Demo Journal", "Demo Notes" and "Starward" (the space travels) at <DEMO_CMS_SUBDOMAIN>,
# <DEMO_CMS_MINIMAL_SUBDOMAIN> and <DEMO_CMS_SPACE_SUBDOMAIN>.<site domain>. One label each, none
# the edge already uses (id, app, console, gw, kb, bench, grafana, mail, prometheus) when the websites
# share DEMO_DOMAIN. The demo websites are created at these hosts on the first start only: `make
# clean` before changing them (README.md, The CMS's demo websites: Starward on an older stack).
DEMO_STUDIO_SUBDOMAIN=studio
DEMO_CMS_SUBDOMAIN=cms
DEMO_CMS_MINIMAL_SUBDOMAIN=minimal
DEMO_CMS_SPACE_SUBDOMAIN=space

# HTTPS: the certificate (PEM, the full chain) and its key, as file names in certs/. The
# certificate must cover <domain>, *.<domain> and *.<site domain> (one certificate, with
# those names). Nothing is obtained from a CA. Both empty:
# plain HTTP. The files there now are self-signed placeholders: replace them with the real ones
# (certs/README.md).
DEMO_TLS_CERT=demo.pacod.io.crt
DEMO_TLS_KEY=demo.pacod.io.key

# The ports. With HTTPS, plain HTTP only redirects to it.
DEMO_HTTP_PORT=80
DEMO_HTTPS_PORT=443

# The address the ports are published on. 0.0.0.0: every network interface, the public
# server. Anything else than a loopback address (127.0.0.1) also closes what is only safe on a
# laptop: the mail viewer, Prometheus and Grafana ask for the admin's email and password, and
# the app's dev tokens (sign-in without a password) are off.
DEMO_BIND=0.0.0.0

# ---- The first administrator ---------------------------------------------------------------

# One account for everything (single sign-on): pacod-id admin, app superuser and admin, gateway
# platform admin, CMS platform admin and knowledge-base admin. Set the password in
# demo.local.env, not here: 12 characters or more. Left empty in both, `make up` generates one
# (shown by `make urls`). On a public server, choose a strong one: it also opens the mail
# viewer, Prometheus and Grafana.
DEMO_ADMIN_EMAIL=admin@pacod.demo
DEMO_ADMIN_PASSWORD=

# ---- Optional component --------------------------------------------------------------------

# `ingestion`: the app's document ingestion service (a ~10 GB image) and the starter agent's
# knowledge base. Empty: off.
DEMO_PROFILES=

# ---- The nightly reset ---------------------------------------------------------------------

# Every day at this time the demo undoes every change made to it: every product's data goes back to
# the baseline (the state the first `make up` made, or the one `make baseline` kept), and the
# products are unavailable for a few minutes meanwhile. The home page says when, in this time zone
# and in the visitor's. HH:MM, 24 hours; empty: no nightly reset (`make reset` still works).
DEMO_RESET_TIME=05:00
# The time zone of DEMO_RESET_TIME: a name from the tz database (UTC, Europe/Berlin, America/New_York).
DEMO_RESET_TIMEZONE=UTC

# ---- Google Search and Analytics -----------------------------------------------------------

# The home page (https://<DEMO_DOMAIN>) and Starward (https://<DEMO_CMS_SPACE_SUBDOMAIN>.<site
# domain>), each told to Google on its own. Empty: nothing of Google's on that page (the default).
#
# Search Console: a URL-prefix property per page, verified with the "HTML tag" method; its meta tag's
# content="..." value goes here (only the value). A domain property, verified by a DNS TXT record on
# the registrable domain, covers both hosts and needs none of these.
#
# Analytics: the home page takes a GA4 measurement id (G-XXXXXXXXXX, gtag.js) or a Google Tag
# Manager container (GTM-XXXXXXX). Starward takes a container only: the CMS loads Google Tag
# Manager, and GA4 reaches it through a Google tag with the measurement id inside that container
# (one container may serve both pages).
#
# The home page's take effect on `make up`. Starward's are written into its settings (the CMS's
# siteSettings: demo.env owns these two fields, an empty value removes them) by `make up`, `make
# reset` (also every night) and `make cms-space`, and show within the CMS's 60-second cache.
DEMO_HOME_GOOGLE_TAG=
DEMO_HOME_GOOGLE_SITE_VERIFICATION=
DEMO_STARWARD_GTM_ID=
DEMO_STARWARD_GOOGLE_SITE_VERIFICATION=

# ---- LLM providers -------------------------------------------------------------------------

# Empty keys: every model call goes to the gateway's mock provider (gw-mock); the demo runs
# offline and `make verify` is deterministic. With at least one key set, `make up` (or
# `make bootstrap`) configures the gateway with the real providers instead; providers without
# a key stay configured but fail their calls. The app's default models are Anthropic's.
# Set the keys in demo.local.env, not here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# The models the products ask the gateway for (names from the gateway's model list,
# pacod-ap/deploy/pacod-gw/platform-config.*.json).
AP_PRIMARY_MODEL=anthropic/claude-sonnet-5-5
AP_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5
CMS_AI_MODEL=anthropic/claude-haiku-4-5
# The CMS per feature, blank for CMS_AI_MODEL: translation, a PDF's abstract and keywords, writing
# help, alt text (a model that takes images) and design assist. The bootstrap hands all six to the
# running studio (/internal/v1/ai-models), which checks each against what the gateway offers; a
# choice made on the studio's installation screen gives way to these at the next bootstrap.
CMS_AI_MODEL_TRANSLATE=
CMS_AI_MODEL_PDF=
CMS_AI_MODEL_ASSIST=
CMS_AI_MODEL_VISION=
CMS_AI_MODEL_DESIGN=
KB_LLM_MODEL=anthropic/claude-haiku-4-5

# ---- Resources -----------------------------------------------------------------------------

# The shared embeddings service (pacod-embeddings, used by the app and the knowledge base):
# `bge` runs BAAI/bge-m3 and its reranker (a 4 GB download on the first start; the whole stack
# then uses about 5 GiB); `hash` is a tiny stand-in with no model (search still works, its
# quality drops); `auto` picks bge when Docker has about 8 GB of memory or more, else hash. The choice is fixed at
# the first `make up` (the stored vectors depend on it); changing it later needs `make clean`.
EMBEDDINGS_BACKEND=auto
# CPU threads for model inference.
TORCH_NUM_THREADS=4

# ---- Logs ----------------------------------------------------------------------------------

# Every product logs the same way (docs/LOGGING.md): one event per line on the container's
# output, read with `make logs S=<service>`, and the same keys in every product (timestamp,
# level, service, logger, message). These two values set all of them, and the edge's request log.
# The level: debug, info, warn or error.
DEMO_LOG_LEVEL=info
# The format: text (readable lines, for `make logs`) or json (one JSON object per line, for a log
# collector such as Loki or Elastic). Log files (below) are JSON either way.
DEMO_LOG_FORMAT=text

# The directory on this machine the log files are written to: <dir>/ap/<service> (the app's
# services: api, admin-api, ingestion-cpu, improvement-loop-worker, newsletter-worker, ...) and
# <dir>/cms (the websites and the studio). Absolute, or relative to pacod-demo. Empty:
# .state/logs, deleted by `make clean`; a directory elsewhere is kept. It must be writable by the
# user who runs `make up`, and on macOS be in Docker Desktop's file sharing (/Users is by
# default). The other services log to their container's output only.
DEMO_LOG_DIR=
